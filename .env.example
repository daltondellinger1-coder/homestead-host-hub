VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function settings. Configure these in Supabase, not in the
# browser build or committed .env files.
# APP_PUBLIC_URL=https://your-production-host
# OPERATIONS_DELIVERY_ENABLED=false
# OPERATIONS_CRON_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CLEANING_CALENDAR_ID=
# RESEND_API_KEY=
# OPERATIONS_EMAIL_FROM=
# MAINTENANCE_SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# Prefer a scoped API key in production. TWILIO_AUTH_TOKEN is a fallback.
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=
